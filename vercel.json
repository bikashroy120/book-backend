{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index" },
    { "source": "/api/docs", "destination": "/api/index" },
    { "source": "/api/docs/:path*", "destination": "/api/index" },
    { "source": "/api/docs-json", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/publish-books",
      "schedule": "0 0 * * *"
    }
  ]
}

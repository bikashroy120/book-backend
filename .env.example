DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hosonta_prokashon
# Optional: set with a serverless PostgreSQL pooler; Vercel defaults to 1.
# DATABASE_POOL_MAX=1
PORT=3000
FRONTEND_URL=http://localhost:3001
ACCESS_TOKEN_SECRET=replace-with-a-secure-access-token-secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=replace-with-a-secure-refresh-token-secret
REFRESH_TOKEN_EXPIRES=7d
UPLOAD_DIR=./uploads
MAIL_FROM=Hosonta Prokashon <noreply@example.com>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional signed presets for browser-to-Cloudinary uploads on Vercel.
# CLOUDINARY_IMAGE_UPLOAD_PRESET=your-signed-image-preset
# CLOUDINARY_PDF_UPLOAD_PRESET=your-signed-pdf-preset
# CLOUDINARY_MANUSCRIPT_UPLOAD_PRESET=your-signed-manuscript-preset
# Required on Vercel to protect scheduled-book publication.
# CRON_SECRET=use-a-random-value-at-least-32-characters-long
NODE_ENV=development
# Required only when running `npx prisma db seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
